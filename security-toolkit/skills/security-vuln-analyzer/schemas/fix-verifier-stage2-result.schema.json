    "closure_recommendation": {"type": "string", "enum": ["YES", "CONDITIONAL YES", "NO", "INCONCLUSIVE"]},
    "closure_conditions": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["residual_scope_or_uncertainty", "tracking_reference", "owner", "acceptance_required"], "properties": {"residual_scope_or_uncertainty": {"type": "string", "minLength": 1}, "tracking_reference": {"type": "string", "minLength": 1}, "owner": {"type": "string", "minLength": 1}, "acceptance_required": {"type": "string", "minLength": 1}}}}
