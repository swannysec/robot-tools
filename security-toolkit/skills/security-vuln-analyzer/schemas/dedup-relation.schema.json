        "other_updated_at": {
          "type": "string"
        },
        "canonical_claims_sha256": {
          "type": "string",
          "pattern": "^([0-9a-f]{64}|)$"
        },
        "other_claims_sha256": {
          "type": "string",
          "pattern": "^([0-9a-f]{64}|)$"
        },
        "canonical_finding_sha256": {
          "type": "string",
          "pattern": "^([0-9a-f]{64}|)$"
        },
        "fix_revision": {
          "type": "string"
        },
        "artifact_sha256s": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^([0-9a-f]{64}|)$"
          }
        }
      }
    },
    "invalidated": {
      "type": "object",
      "additionalProperties": false,
      "required": [
