{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["title", "author", "published", "tldr", "summary", "takeaways", "detailed_notes", "quotes", "references", "tags", "chapters", "thread"],
  "properties": {
    "title": {"type": "string", "minLength": 1},
    "author": {"type": ["string", "null"]},
    "published": {"type": ["string", "null"]},
    "tldr": {"type": "string", "minLength": 1},
    "summary": {"type": "string", "minLength": 1},
    "takeaways": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "detailed_notes": {"type": "string"},
    "quotes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["text", "attribution"],
        "properties": {
          "text": {"type": "string", "minLength": 1},
          "attribution": {"type": ["string", "null"]}
        }
      }
    },
    "references": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "type", "url"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "type": {"enum": ["tool", "book", "person", "project"]},
          "url": {"type": ["string", "null"]}
        }
      }
    },
    "tags": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"}},
    "chapters": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["time", "title"],
        "properties": {
          "time": {"type": "string"},
          "title": {"type": "string", "minLength": 1}
        }
      }
    },
    "thread": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    }
  }
}
