          "type": "string",
          "pattern": "^([0-9a-f]{64}|)$"
        },
        "other_body_sha256": {
          "type": "string",
          "pattern": "^([0-9a-f]{64}|)$"
        },
        "canonical_updated_at": {
          "type": "string"
