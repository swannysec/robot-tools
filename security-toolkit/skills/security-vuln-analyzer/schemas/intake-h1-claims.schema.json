{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "role_type",
    "status",
    "provider",
    "model",
    "effort",
    "packet_revision",
    "ghsa_id",
    "claims",
    "versions_quoted",
    "poc_blocks",
    "declined_scope"
  ],
  "properties": {
    "role_type": {
      "type": "string",
      "enum": [
        "intake_h1"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "COMPLETE",
        "MALFORMED",
        "FAILED",
        "MISSING"
      ]
    },
    "provider": {
      "type": "string"
    },
    "model": {
      "type": "string"
    },
    "effort": {
      "type": "string",
      "enum": [
        "high"
      ]
    },
    "packet_revision": {
      "type": "string"
    },
    "ghsa_id": {
      "type": "string",
      "pattern": "^GHSA(-[23456789cfghjmpqrvwx]{4}){3}$"
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "claim_id",
          "statement_quote",
          "entry_point_quote",
          "literals"
        ],
        "properties": {
          "claim_id": {
            "type": "string",
            "pattern": "^C[0-9]{1,3}$"
          },
          "statement_quote": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "entry_point_quote": {
            "type": "string",
            "maxLength": 4000
          },
          "literals": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "entry_point_symbols",
              "file_paths",
              "config_keys",
              "commands_or_settings",
              "advisory_references"
            ],
            "properties": {
              "entry_point_symbols": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[A-Za-z_][A-Za-z0-9_:.<>]{0,199}$",
                  "maxLength": 200
                },
                "maxItems": 20
              },
              "file_paths": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_./-]{1,300}$",
                  "maxLength": 300
                },
                "maxItems": 20
              },
              "config_keys": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_.:-]{1,200}$",
                  "maxLength": 200
                },
                "maxItems": 20
              },
              "commands_or_settings": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_.:/-]{1,120}$",
                  "maxLength": 120
                },
                "maxItems": 20
              },
              "advisory_references": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^(GHSA(-[23456789cfghjmpqrvwx]{4}){3}|CVE-[0-9]{4}-[0-9]{4,7})$",
                  "maxLength": 40
                },
                "maxItems": 20
              }
            }
          }
        }
      },
      "maxItems": 50
    },
    "versions_quoted": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4000
      },
      "maxItems": 20
    },
    "poc_blocks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "quote"
        ],
        "properties": {
          "quote": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20000
          }
        }
      },
      "maxItems": 20
    },
    "declined_scope": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "task_element",
          "reason"
        ],
        "properties": {
          "task_element": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "description": "H1 literal extraction and D1 claim split. Every quote and literal must be an exact substring of one captured advisory field; scripts/intake-check.py enforces this."
}
