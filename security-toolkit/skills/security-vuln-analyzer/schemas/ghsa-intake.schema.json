{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_type",
    "schema_version",
    "adapter",
    "adapter_version",
    "repository",
    "input_form",
    "run_id",
    "retrieved_at_utc",
    "api_version",
    "raw",
    "advisory",
    "pinned_target"
  ],
  "properties": {
    "record_type": {
      "type": "string",
      "enum": [
        "ghsa_intake"
      ]
    },
    "schema_version": {
      "type": "string",
      "enum": [
        "1"
      ]
    },
    "adapter": {
      "type": "string"
    },
    "adapter_version": {
      "type": "string"
    },
    "repository": {
      "type": "string"
    },
    "input_form": {
      "type": "string",
      "enum": [
        "URL",
        "ID_AND_REPO"
      ]
    },
    "run_id": {
      "type": "string"
    },
    "retrieved_at_utc": {
      "type": "string"
    },
    "api_version": {
      "type": "string"
    },
    "raw": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "advisory_file",
        "advisory_sha256",
        "comments_file",
        "comments_sha256",
        "comments_status",
        "comments_count_field"
      ],
      "properties": {
        "advisory_file": {
          "type": "string"
        },
        "advisory_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "comments_file": {
          "type": "string"
        },
        "comments_sha256": {
          "type": "string"
        },
        "comments_status": {
          "type": "string",
          "enum": [
            "CAPTURED",
            "CAPTURED_INCOMPLETE",
            "UNAVAILABLE"
          ]
        },
        "comments_count_field": {
          "type": "integer"
        }
      }
    },
    "advisory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ghsa_id",
        "cve_id",
        "html_url",
        "state",
        "created_at",
        "updated_at",
        "submission_accepted",
        "author_login",
        "summary",
        "description",
        "body_sha256",
        "comments",
        "reporter_claims",
        "private_fork"
      ],
      "properties": {
        "ghsa_id": {
          "type": "string"
        },
        "cve_id": {
          "type": "string"
        },
        "html_url": {
          "type": "string"
        },
        "state": {
          "type": "string"
        },
        "created_at": {
          "type": "string"
        },
        "updated_at": {
          "type": "string"
        },
        "submission_accepted": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "author_login": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "body_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "comments": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "comment_id",
              "author_login",
              "created_at",
              "body"
            ],
            "properties": {
              "comment_id": {
                "type": "string"
              },
              "author_login": {
                "type": "string"
              },
              "created_at": {
                "type": "string"
              },
              "body": {
                "type": "string"
              }
            }
          }
        },
        "reporter_claims": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "label",
            "severity",
            "cvss_v3_vector",
            "cvss_v4_vector",
            "cwe_ids",
            "vulnerabilities"
          ],
          "properties": {
            "label": {
              "type": "string"
            },
            "severity": {
              "type": "string"
            },
            "cvss_v3_vector": {
              "type": "string"
            },
            "cvss_v4_vector": {
              "type": "string"
            },
            "cwe_ids": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "vulnerabilities": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "ecosystem",
                  "package",
                  "vulnerable_version_range",
                  "patched_versions",
                  "vulnerable_functions"
                ],
                "properties": {
                  "ecosystem": {
                    "type": "string"
                  },
                  "package": {
                    "type": "string"
                  },
                  "vulnerable_version_range": {
                    "type": "string"
                  },
                  "patched_versions": {
                    "type": "string"
                  },
                  "vulnerable_functions": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        },
        "private_fork": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "present",
            "full_name"
          ],
          "properties": {
            "present": {
              "type": "boolean"
            },
            "full_name": {
              "type": "string"
            }
          }
        }
      }
    },
    "pinned_target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "revision",
        "revision_source",
        "ref"
      ],
      "properties": {
        "repository": {
          "type": "string"
        },
        "revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "revision_source": {
          "type": "string",
          "enum": [
            "DEFAULT_BRANCH_HEAD",
            "EXACT_TAG",
            "USER_SELECTED"
          ]
        },
        "ref": {
          "type": "string"
        }
      }
    }
  },
  "description": "Captured GHSA intake record written by scripts/ghsa-fetch.py. Not a model role output, so it has no declined_scope. Advisory text is untrusted data; reporter claims never populate discovery scoring."
}
