{
  "type": "object",
  "additionalProperties": false,
  "required": ["role_type", "status", "provider", "model", "effort", "packet_revision", "pinned_revisions", "scope", "evidence", "counterevidence", "candidates"],
  "properties": {
    "role_type": {"type": "string", "enum": ["discovery"]},
    "status": {"type": "string", "enum": ["COMPLETE", "MALFORMED", "FAILED", "MISSING"]},
    "provider": {"type": "string"},
    "model": {"type": "string"},
    "effort": {"type": "string", "enum": ["high"]},
    "packet_revision": {"type": "string"},
    "pinned_revisions": {"type": "array", "items": {"type": "string"}},
    "scope": {"type": "string"},
    "evidence": {"type": "array", "items": {"$ref": "#/$defs/citation"}},
    "counterevidence": {"type": "array", "items": {"$ref": "#/$defs/citation"}},
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role_local_id", "normalized_proposition", "proposed_disposition", "affects_security_claim", "locations", "context_dependencies", "evidence", "counterevidence", "assumptions", "uncertainty", "attacker_preconditions", "reachability_trace", "affected_boundary", "primitive_class", "variant_family", "enumerated_variants", "enumeration_source", "validity", "reachability", "impact", "mitigation_or_fix_state", "confidence", "priority", "scoring", "deterministic_checks", "invariant_test_contract"],
        "properties": {
          "role_local_id": {"type": "string"},
          "normalized_proposition": {"type": "string"},
          "proposed_disposition": {"type": "string", "enum": ["vulnerability finding", "primary-control weakness", "hardening or secure-code note", "reliability or maintainability signal"]},
          "affects_security_claim": {"type": "boolean"},
          "locations": {"type": "array", "items": {"$ref": "#/$defs/location"}},
          "context_dependencies": {"type": "array", "items": {"$ref": "#/$defs/citation"}},
          "evidence": {"type": "array", "items": {"$ref": "#/$defs/citation"}},
          "counterevidence": {"type": "array", "items": {"$ref": "#/$defs/citation"}},
          "assumptions": {"type": "array", "items": {"type": "string"}},
          "uncertainty": {"type": "array", "items": {"type": "string"}},
          "attacker_preconditions": {"type": "array", "items": {"type": "string"}},
          "reachability_trace": {"type": "array", "items": {"type": "string"}},
          "affected_boundary": {"type": "string"},
          "primitive_class": {"type": "string"},
          "variant_family": {"type": "string"},
          "enumerated_variants": {"type": "array", "items": {"type": "string"}},
          "enumeration_source": {"type": "array", "items": {"$ref": "#/$defs/citation"}},
          "validity": {"type": "string"},
          "reachability": {"type": "string"},
          "impact": {"type": "string"},
          "mitigation_or_fix_state": {"type": "string"},
          "confidence": {"type": "string"},
          "priority": {"type": "string"},
          "scoring": {"$ref": "#/$defs/scoring"},
          "deterministic_checks": {"type": "array", "items": {"$ref": "#/$defs/deterministic_check"}},
          "invariant_test_contract": {
            "type": "object",
            "additionalProperties": false,
            "required": ["applicable", "version", "invariant", "adversarial_input_classes", "expected_secure_behavior", "sink_or_observable", "deterministic_oracle", "benign_control", "implementation_pitfalls"],
            "properties": {
              "applicable": {"type": "boolean"},
              "version": {"type": "string"},
              "invariant": {"type": "string"},
              "adversarial_input_classes": {"type": "array", "items": {"type": "string"}},
              "expected_secure_behavior": {"type": "string"},
              "sink_or_observable": {"type": "string"},
              "deterministic_oracle": {"type": "string"},
              "benign_control": {"type": "string"},
              "implementation_pitfalls": {"type": "array", "items": {"type": "string"}}
            }
          }
        }
      }
    }
  },
  "$defs": {
    "scoring": {
      "type": "object", "additionalProperties": false,
      "required": ["cvss_v4", "epss", "kev"],
      "properties": {"cvss_v4": {"$ref": "#/$defs/cvss_v4"}, "epss": {"$ref": "#/$defs/epss"}, "kev": {"$ref": "#/$defs/kev"}}
    },
    "cvss_v4": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "vector", "score", "score_type", "calculator_version", "inputs", "rationale", "evidence"],
      "properties": {
        "status": {"type": "string", "enum": ["SCORED", "NOT SCORED", "NOT APPLICABLE"]},
        "vector": {"type": "string"}, "score": {"type": ["number", "null"]}, "score_type": {"type": "string"},
        "calculator_version": {"type": "string"}, "inputs": {"type": "array", "items": {"type": "string"}},
        "rationale": {"type": "string"}, "evidence": {"type": "array", "items": {"$ref": "#/$defs/citation"}}
      }
    },
    "epss": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "cve", "probability", "percentile", "retrieved_at_utc", "version", "rationale", "evidence"],
      "properties": {
        "status": {"type": "string", "enum": ["RETRIEVED", "NO CVE", "NOT RETRIEVED", "NOT APPLICABLE"]},
        "cve": {"type": "string"}, "probability": {"type": ["number", "null"]}, "percentile": {"type": ["number", "null"]},
        "retrieved_at_utc": {"type": "string"}, "version": {"type": "string"},
        "rationale": {"type": "string"}, "evidence": {"type": "array", "items": {"$ref": "#/$defs/citation"}}
      }
    },
    "kev": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "cve", "membership", "retrieved_at_utc", "version", "rationale", "evidence"],
      "properties": {
        "status": {"type": "string", "enum": ["RETRIEVED", "NO CVE", "NOT RETRIEVED", "NOT APPLICABLE"]},
        "cve": {"type": "string"}, "membership": {"type": "string", "enum": ["LISTED", "NOT LISTED", "UNKNOWN"]},
        "retrieved_at_utc": {"type": "string"}, "version": {"type": "string"},
        "rationale": {"type": "string"}, "evidence": {"type": "array", "items": {"$ref": "#/$defs/citation"}}
      }
    },
    "location": {
      "type": "object", "additionalProperties": false,
      "required": ["repository", "revision", "relative_path", "start_line", "end_line"],
      "properties": {"repository": {"type": "string"}, "revision": {"type": "string"}, "relative_path": {"type": "string"}, "start_line": {"type": "integer"}, "end_line": {"type": "integer"}}
    },
    "citation": {
      "type": "object", "additionalProperties": false,
      "required": ["source_kind", "repository", "revision", "relative_path", "start_line", "end_line", "quote", "observation", "artifact_id"],
      "properties": {"source_kind": {"type": "string", "enum": ["repository", "deterministic_check", "runtime_observation", "authoritative_source"]}, "repository": {"type": "string"}, "revision": {"type": "string"}, "relative_path": {"type": "string"}, "start_line": {"type": "integer"}, "end_line": {"type": "integer"}, "quote": {"type": "string"}, "observation": {"type": "string"}, "artifact_id": {"type": "string"}}
    },
    "deterministic_check": {
      "type": "object", "additionalProperties": false,
      "required": ["check_id", "check_kind", "repository", "revision", "relative_path", "start_line", "end_line", "expected_sha256", "registry_sha256", "frozen_test_id", "literal_result_states", "routing_table"],
      "properties": {
        "check_id": {"type": "string"},
        "check_kind": {"type": "string", "enum": ["SOURCE_SLICE_SHA256", "FROZEN_TEST_REFERENCE"]},
        "repository": {"type": "string"}, "revision": {"type": "string"}, "relative_path": {"type": "string"},
        "start_line": {"type": "integer"}, "end_line": {"type": "integer"}, "expected_sha256": {"type": "string"}, "registry_sha256": {"type": "string"}, "frozen_test_id": {"type": "string"},
        "literal_result_states": {"type": "array", "items": {"type": "string", "enum": ["MATCHED", "NOT_MATCHED", "PASSED", "FAILED", "UNRESOLVED", "NOT_RUN"]}},
        "routing_table": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["literal_result", "final_status"], "properties": {"literal_result": {"type": "string", "enum": ["MATCHED", "NOT_MATCHED", "PASSED", "FAILED", "UNRESOLVED", "NOT_RUN"]}, "final_status": {"type": "string", "enum": ["CROSS-MODEL VERIFIED", "REFUTED", "DISPUTED", "NOT VERIFIED", "INCOMPLETE"]}}}}
      }
    }
  }
}
